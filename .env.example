# Password for the admin area at /admin
ADMIN_PASSWORD=change-me

# Long random string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Where the database and all photos and videos are stored.
# In Docker this is the mapped volume, /data.
DATA_DIR=./data

# Optional limits (megabytes)
MAX_PHOTO_MB=40
MAX_VIDEO_MB=1024
